#!/usr/bin/make -f
# -*- makefile -*-

export DH_VERBOSE = 1
export PYTHONDONTWRITEBYTECODE = 1
export DH_PIP_DISABLE_INSTALL = 1
# 让 pybuild 在 build 时使用 PEP 517/518 + pyproject.toml
export PYBUILD_SYSTEM = pyproject

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_clean:
	rm -rf build dist *.egg-info .pybuild/ .wheels/
	dh_auto_clean

override_dh_auto_configure:
	# 纯 Python，无需 configure

override_dh_auto_build:
	dh_auto_build
	# 仅当运行 dpkg-buildpackage 时安装 pip-only 依赖的 wheel 缓存
	mkdir -p .wheels
	pip wheel --no-deps --wheel-dir=.wheels \
		pynput sounddevice ffmpeg-python future 2>&1

override_dh_auto_install:
	dh_auto_install
	# 1. 安装 pip-only 依赖的 wheel 到 debian/recordly/usr/lib/python3/dist-packages
	for whl in .wheels/*.whl; do \
		[ -f "$$whl" ] || continue; \
		pip install --no-deps --no-compile \
			--root=$(CURDIR)/debian/recordly \
			--target=/usr/lib/python3/dist-packages \
			--no-index --find-links=.wheels \
			"$$whl"; \
	done
	# 2. 安装桌面入口文件和图标
	install -D -m 0644 debian/recordly.desktop \
		$(CURDIR)/debian/recordly/usr/share/applications/recordly.desktop
	install -D -m 0644 resources/icons/recordly.svg \
		$(CURDIR)/debian/recordly/usr/share/icons/hicolor/scalable/apps/recordly.svg
	install -D -m 0644 debian/io.github.devcxl.recordly.appdata.xml \
		$(CURDIR)/debian/recordly/usr/share/metainfo/io.github.devcxl.recordly.appdata.xml

override_dh_auto_test:
	# CI 分离，打包时不运行测试

override_dh_compress:
	# Python 源文件不需要压缩
	dh_compress -X.py

override_dh_strip:
	# Python 包不需要 strip